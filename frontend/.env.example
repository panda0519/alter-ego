# Public configuration only. Vite values are visible to all visitors.
VITE_AGENT37_URL=
# Public HTTPS export URL only; leave blank to check the local export.
# Agent37 itself must be configured with the real deployed context URL.
VITE_AGENT_CONTEXT_URL=
# Optional public base URL of the server-side assistant proxy. Never put an API key here.
# Examples: /api/assistant or http://127.0.0.1:8787/api/assistant
VITE_AGENT_PROXY_URL=
