{
  "name": "alter-ego-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:data": "node ./checks/validate-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec checks/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "leaflet": "1.9.4",
    "recharts": "3.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/leaflet": "1.9.22"
  }
}
