{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alter Ego predictions 1.0.0",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_kind": {
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "artifact_kind": {
          "enum": [
            "fixture",
            "model_output"
          ]
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "default_method": {
          "enum": [
            "idw",
            "gcn_lstm",
            "gcn_lstm_physics"
          ]
        },
        "depth_unit": {
          "const": "m_below_ground"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "dataset_id",
        "dataset_kind",
        "artifact_kind",
        "generated_at_utc",
        "as_of_date",
        "default_method",
        "depth_unit",
        "caption"
      ],
      "additionalProperties": false
    },
    "dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "wells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "role": {
            "enum": [
              "visible",
              "train_masked",
              "holdout"
            ]
          },
          "observations_m": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "predictions_m": {
            "type": "object",
            "properties": {
              "idw": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "gcn_lstm": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "gcn_lstm_physics": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "idw",
              "gcn_lstm",
              "gcn_lstm_physics"
            ],
            "additionalProperties": false
          },
          "summaries": {
            "type": "object",
            "properties": {
              "idw": {
                "type": "object",
                "properties": {
                  "latest_depth_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "change_30d_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "priority": {
                    "enum": [
                      "high",
                      "watch",
                      "normal",
                      "unknown"
                    ]
                  },
                  "reason_codes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "latest_depth_m",
                  "change_30d_m",
                  "priority",
                  "reason_codes"
                ],
                "additionalProperties": false
              },
              "gcn_lstm": {
                "type": "object",
                "properties": {
                  "latest_depth_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "change_30d_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "priority": {
                    "enum": [
                      "high",
                      "watch",
                      "normal",
                      "unknown"
                    ]
                  },
                  "reason_codes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "latest_depth_m",
                  "change_30d_m",
                  "priority",
                  "reason_codes"
                ],
                "additionalProperties": false
              },
              "gcn_lstm_physics": {
                "type": "object",
                "properties": {
                  "latest_depth_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "change_30d_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "priority": {
                    "enum": [
                      "high",
                      "watch",
                      "normal",
                      "unknown"
                    ]
                  },
                  "reason_codes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "latest_depth_m",
                  "change_30d_m",
                  "priority",
                  "reason_codes"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "idw",
              "gcn_lstm",
              "gcn_lstm_physics"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "latitude",
          "longitude",
          "role",
          "observations_m",
          "predictions_m",
          "summaries"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "dates",
    "wells"
  ],
  "additionalProperties": false
}
